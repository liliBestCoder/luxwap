<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.XrayActivityParticipantsMapper">
    
    <resultMap type="XrayActivityParticipants" id="ActivityParticipantsResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="registrationTime"    column="registration_time"    />
        <result property="userEmail"    column="user_email"    />
        <result property="userName"    column="user_name"    />
        <result property="member"    column="member"    />
        <result property="expiration"    column="expiration"    />
        <result property="rank"    column="rank"    />
        <result property="type"    column="type"    />
        <result property="activityId"    column="activity_id"    />
        <result property="auditLink"    column="audit_link"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
    </resultMap>

    <sql id="selectActivityParticipantsVo">
        select id, user_id, registration_time, user_email, user_name, `member`, expiration, `rank`, `type`, activity_id, audit_link, created_at, updated_at from xray_activity_participants
    </sql>

    <select id="selectActivityParticipantsByConditions" resultMap="ActivityParticipantsResult">
        <include refid="selectActivityParticipantsVo"/>
        WHERE 1=1 and activity_id = #{activityId}
        <if test="userName != null">
            AND user_name LIKE CONCAT('%', #{userName}, '%')
        </if>
        <if test="rank != null">
            AND `rank` = #{rank}
        </if>
        <if test="type != null and type != ''">
            AND `type` = #{type}
        </if>
        <if test="startDate != null">
            AND registration_time &gt;= #{startDate}
        </if>
        <if test="endDate != null">
            AND registration_time &lt;= #{endDate}
        </if>
    </select>

    <select id="selectActivityParticipantsList" parameterType="XrayActivityParticipants" resultMap="ActivityParticipantsResult">
        <include refid="selectActivityParticipantsVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="registrationTime != null "> and registration_time = #{registrationTime}</if>
            <if test="userEmail != null  and userEmail != ''"> and user_email = #{userEmail}</if>
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="member != null "> and `member` = #{member}</if>
            <if test="expiration != null "> and expiration = #{expiration}</if>
            <if test="rank != null "> and `rank` = #{rank}</if>
            <if test="type != null  and type != ''"> and `type` = #{type}</if>
            <if test="activityId != null "> and activity_id = #{activityId}</if>
            <if test="auditLink != null  and auditLink != ''"> and audit_link = #{auditLink}</if>
            <if test="createdAt != null "> and created_at = #{createdAt}</if>
            <if test="updatedAt != null "> and updated_at = #{updatedAt}</if>
        </where>
    </select>
    
    <select id="selectActivityParticipantsById" parameterType="Long" resultMap="ActivityParticipantsResult">
        <include refid="selectActivityParticipantsVo"/>
        where id = #{id}
    </select>

    <insert id="insertActivityParticipants" parameterType="XrayActivityParticipants" useGeneratedKeys="true" keyProperty="id">
        insert into xray_activity_participants
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="registrationTime != null">registration_time,</if>
            <if test="userEmail != null and userEmail != ''">user_email,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="member != null">`member`,</if>
            <if test="expiration != null">expiration,</if>
            <if test="rank != null">`rank`,</if>
            <if test="type != null">`type`,</if>
            <if test="activityId != null">activity_id,</if>
            <if test="auditLink != null">audit_link,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="registrationTime != null">#{registrationTime},</if>
            <if test="userEmail != null and userEmail != ''">#{userEmail},</if>
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="member != null">#{member},</if>
            <if test="expiration != null">#{expiration},</if>
            <if test="rank != null">#{rank},</if>
            <if test="type != null">#{type},</if>
            <if test="activityId != null">#{activityId},</if>
            <if test="auditLink != null">#{auditLink},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
         </trim>
    </insert>

    <update id="updateActivityParticipants" parameterType="XrayActivityParticipants">
        update xray_activity_participants
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="registrationTime != null">registration_time = #{registrationTime},</if>
            <if test="userEmail != null and userEmail != ''">user_email = #{userEmail},</if>
            <if test="userName != null and userName != ''">user_name = #{userName},</if>
            <if test="member != null">`member` = #{member},</if>
            <if test="expiration != null">expiration = #{expiration},</if>
            <if test="rank != null">`rank` = #{rank},</if>
            <if test="type != null">`type` = #{type},</if>
            <if test="activityId != null">activity_id = #{activityId},</if>
            <if test="auditLink != null">audit_link = #{auditLink},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteActivityParticipantsById" parameterType="Long">
        delete from xray_activity_participants where id = #{id}
    </delete>

    <delete id="deleteActivityParticipantsByIds" parameterType="String">
        delete from xray_activity_participants where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>