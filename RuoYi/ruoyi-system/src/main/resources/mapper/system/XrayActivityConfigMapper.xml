<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.XrayActivityConfigMapper">
    
    <resultMap type="XrayActivityConfig" id="XrayActivityConfigResult">
        <result property="id"    column="id"    />
        <result property="participantsCnt"    column="participants_cnt"    />
        <result property="moderatorsCnt"    column="moderators_cnt"    />
        <result property="status"    column="status"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
    </resultMap>

    <sql id="selectXrayActivityConfigVo">
        select id, participants_cnt, moderators_cnt, status, created_at, updated_at from xray_activity_config
    </sql>

    <select id="selectXrayActivityConfigList" parameterType="XrayActivityConfig" resultMap="XrayActivityConfigResult">
        <include refid="selectXrayActivityConfigVo"/>
        <where>  
            <if test="participantsCnt != null "> and participants_cnt = #{participantsCnt}</if>
            <if test="moderatorsCnt != null "> and moderators_cnt = #{moderatorsCnt}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="createdAt != null "> and created_at = #{createdAt}</if>
            <if test="updatedAt != null "> and updated_at = #{updatedAt}</if>
        </where>
    </select>
    
    <select id="selectXrayActivityConfigById" parameterType="Long" resultMap="XrayActivityConfigResult">
        <include refid="selectXrayActivityConfigVo"/>
        where id = #{id}
    </select>

    <insert id="insertXrayActivityConfig" parameterType="XrayActivityConfig" useGeneratedKeys="true" keyProperty="id">
        insert into xray_activity_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="participantsCnt != null">participants_cnt,</if>
            <if test="moderatorsCnt != null">moderators_cnt,</if>
            <if test="status != null">status,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="participantsCnt != null">#{participantsCnt},</if>
            <if test="moderatorsCnt != null">#{moderatorsCnt},</if>
            <if test="status != null">#{status},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
         </trim>
    </insert>

    <update id="updateXrayActivityConfig" parameterType="XrayActivityConfig">
        update xray_activity_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="participantsCnt != null">participants_cnt = #{participantsCnt},</if>
            <if test="moderatorsCnt != null">moderators_cnt = #{moderatorsCnt},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXrayActivityConfigById" parameterType="Long">
        delete from xray_activity_config where id = #{id}
    </delete>

    <delete id="deleteXrayActivityConfigByIds" parameterType="String">
        delete from xray_activity_config where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>