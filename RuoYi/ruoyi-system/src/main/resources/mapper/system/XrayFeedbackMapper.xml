<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.XrayFeedbackMapper">
    
    <resultMap type="XrayFeedback" id="XrayFeedbackResult">
        <result property="id"           column="id"            />
        <result property="userId"       column="user_id"       />
        <result property="userName"     column="user_name"     />
        <result property="type"         column="type"          />
        <result property="title"        column="title"         />
        <result property="content"      column="content"       />
        <result property="contact"      column="contact"       />
        <result property="appVersion"   column="app_version"   />
        <result property="platform"     column="platform"      />
        <result property="status"       column="status"        />
        <result property="replyContent" column="reply_content" />
        <result property="replyTime"    column="reply_time"    />
        <result property="delFlag"      column="del_flag"      />
        <result property="createTime"   column="create_time"   />
        <result property="updateTime"   column="update_time"   />
    </resultMap>

    <sql id="selectXrayFeedbackVo">
        select id, user_id, user_name, type, title, content, contact, app_version, platform, status, reply_content, reply_time, del_flag, create_time, update_time
        from xray_feedback
    </sql>

    <select id="selectFeedbackList" parameterType="XrayFeedback" resultMap="XrayFeedbackResult">
        <include refid="selectXrayFeedbackVo"/>
        <where>
            del_flag = '0'
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="userName != null and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="type != null and type != ''"> and type = #{type}</if>
            <if test="status != null"> and status = #{status}</if>
            <if test="platform != null and platform != ''"> and platform = #{platform}</if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectFeedbackById" parameterType="Long" resultMap="XrayFeedbackResult">
        <include refid="selectXrayFeedbackVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <insert id="insertFeedback" parameterType="XrayFeedback" useGeneratedKeys="true" keyProperty="id">
        insert into xray_feedback
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="type != null and type != ''">type,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="contact != null and contact != ''">contact,</if>
            <if test="appVersion != null and appVersion != ''">app_version,</if>
            <if test="platform != null and platform != ''">platform,</if>
            <if test="status != null">status,</if>
            <if test="replyContent != null and replyContent != ''">reply_content,</if>
            <if test="replyTime != null">reply_time,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            create_time,
            update_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="type != null and type != ''">#{type},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="contact != null and contact != ''">#{contact},</if>
            <if test="appVersion != null and appVersion != ''">#{appVersion},</if>
            <if test="platform != null and platform != ''">#{platform},</if>
            <if test="status != null">#{status},</if>
            <if test="replyContent != null and replyContent != ''">#{replyContent},</if>
            <if test="replyTime != null">#{replyTime},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            sysdate(),
            sysdate()
        </trim>
    </insert>

    <update id="updateFeedback" parameterType="XrayFeedback">
        update xray_feedback
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null">status = #{status},</if>
            <if test="replyContent != null and replyContent != ''">reply_content = #{replyContent},</if>
            <if test="replyTime != null">reply_time = #{replyTime},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
            update_time = sysdate()
        </trim>
        where id = #{id}
    </update>
</mapper>
