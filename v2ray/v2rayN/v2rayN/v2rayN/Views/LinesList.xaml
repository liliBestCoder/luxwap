<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.LinesList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:materialDesignCards="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:v2rayN.ViewModels"
    x:TypeArguments="vms:LineListViewModel"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d"
    Background="White"
    SizeChanged="Window_SizeChanged">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 顶部状态条 -->
            <RowDefinition Height="Auto"/>
            <!-- 标题和按钮 -->
            <RowDefinition Height="*"/>
            <!-- 线路列表 -->
        </Grid.RowDefinitions>

        <!-- 顶部状态条 -->
        <Border Grid.Row="0" CornerRadius="10" Height="50" Background="#21D15B" Padding="5" Margin="10,20,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- 左侧状态 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- START/STOP -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- ToggleButton -->
                </Grid.ColumnDefinitions>

                <!-- 左侧状态文本 -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <Image Source="/Resources/rocket.png" Width="24" Height="24" Margin="0,0,10,0"/>
                    <TextBlock VerticalAlignment="Center" Foreground="#FCFFFD" FontWeight="Bold" FontSize="14" x:Name="StatusBar">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="未连接"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=SwitchBtn}" Value="True">
                                        <Setter Property="Text" Value="已连接"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- 中间 START/STOP -->
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#FCFFFD" FontWeight="Bold" FontSize="14" Margin="5,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="START"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=SwitchBtn}" Value="True">
                                    <Setter Property="Text" Value="STOP"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ToggleButton -->
                <ToggleButton Grid.Column="2" Width="40" Height="40" x:Name="SwitchBtn" Click="SwitchBtn_Click" Cursor="Hand" Margin="10,0">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Ellipse x:Name="Circle" Width="40" Height="40" Fill="#FFFF9923"/>
                                <Rectangle x:Name="Square" Width="10" Height="10" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path x:Name="Triangle" Fill="White" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Data="M 0 0 L 0 10 L 10 5 Z"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="Circle" Property="Fill" Value="LightGray"/>
                                    <Setter TargetName="Square" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Triangle" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Circle" Property="Fill" Value="#FFFF9923"/>
                                    <Setter TargetName="Square" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Triangle" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- 标题 + 按钮行 -->
        <Grid Grid.Row="1" Margin="10,10,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- 标题自适应 -->
                <ColumnDefinition Width="Auto"/>
                <!-- 筛选按钮 -->
                <ColumnDefinition Width="Auto"/>
                <!-- 刷新按钮 -->
            </Grid.ColumnDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Column="0" Text="线路列表" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>

            <!-- 筛选按钮 -->
            <Button Grid.Column="1" Width="80" Height="30" Cursor="Hand" Margin="10,0,0,0" x:Name="FilterButton" Click="FilterButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10" Background="#F5F5F7" Padding="5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="/Resources/select.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                <TextBlock Text="筛选" VerticalAlignment="Center" Foreground="#1B1B1B"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E9F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.ContextMenu >
                    <ContextMenu x:Name="FilterMenu"
             Width="95">

                        <ContextMenu.Resources>
                            <!-- 缩小 MenuItem 前面对号的空间 -->
                            <Style TargetType="MenuItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border Background="{TemplateBinding Background}">
                                                <Grid Margin="2">
                                                    <Grid.ColumnDefinitions>
                                                        <!-- 缩小 CheckMark 区域宽度 -->
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 对号 -->
                                                    <ContentPresenter x:Name="Icon"
                                                  Content="{TemplateBinding Icon}"
                                                  Width="10" Height="10"
                                                  Margin="1,0,0,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  RecognizesAccessKey="True"/>

                                                    <!-- 文本 -->
                                                    <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  Margin="4,0,0,0"/>
                                                </Grid>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Icon" Property="Content">
                                                        <Setter.Value>
                                                            <Path Data="M 0 5 L 3 8 L 8 0"
                                              Stroke="Black"
                                              StrokeThickness="2"
                                              Stretch="Uniform"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter Property="Background" Value="#E9F0FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ContextMenu.Resources>

                        <!-- 菜单项 -->
                        <MenuItem Header="All" IsCheckable="True"/>
                        <MenuItem Header="High" IsCheckable="True"/>
                        <MenuItem Header="Medium" IsCheckable="True"/>
                        <MenuItem Header="Low" IsCheckable="True"/>
                    </ContextMenu>

                </Button.ContextMenu>
            </Button >

            <!-- 刷新按钮 -->
            <Button Grid.Column="2" Width="80" Height="30" Cursor="Hand" Margin="10,0,0,0" Click="RefreshButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10" Background="#F5F5F7" Padding="5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="/Resources/fresh.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                <TextBlock Text="刷新" VerticalAlignment="Center" Foreground="#1B1B1B"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E9F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 线路列表 -->
        <ScrollViewer Grid.Row="2"  VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              CanContentScroll="True" Height="500" x:Name="LineListScrollViewer">
            <ItemsControl x:Name="GroupedNodesControl" ItemsSource="{Binding GroupedNodes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 用 VirtualizingStackPanel 而不是默认的 StackPanel -->
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Stretch" Margin="10,0,10,0">
                            <!-- 区域标题 -->
                            <Border Background="#F5F5F7" CornerRadius="4" Margin="0,10,0,0" Padding="5">
                                <Grid Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="/Resources/area.png" Grid.Column="0" Width="16" Margin="0,0,0,0"/>
                                    <TextBlock Text="{Binding Region}" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0" Foreground="#1B1B1B" FontSize="14"/>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Nodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="0" Margin="0,5,0,5">
                                            <Grid Height="60" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <!-- 单选按钮 -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- 名称 -->
                                                    <ColumnDefinition Width="70"/>
                                                    <!-- 延迟 -->
                                                    <ColumnDefinition Width="50"/>
                                                    <!-- 图片 -->
                                                </Grid.ColumnDefinitions>

                                                <RadioButton Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 GroupName="lines" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>

                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="5,0"/>

                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0">
                        <Run Text="{Binding Speed}" Foreground="#286AFC" FontSize="14" FontWeight="Bold"/>
                        <Run Text="{Binding SpeedUnit}"/>
                                                </TextBlock>

                                                <Image Grid.Column="3" Source="/Resources/crowded.png" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                                <!-- 虚线 -->
                                                <Line Grid.ColumnSpan="4"
                                                  X1="0" X2="1"
                                                  Stretch="Fill"
                                                  Stroke="Gray"
                                                  StrokeDashArray="2,2"
                                                  StrokeThickness="1"
                                                  VerticalAlignment="Center"
                                                  Margin="120,0,180,0"/>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>


                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</reactiveui:ReactiveUserControl>
