<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:materialDesignCards="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:v2rayN.ViewModels"
    x:TypeArguments="vms:SettingsViewModel"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:IntStringConverter x:Key="IntStringConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <materialDesignCards:Card Margin="0,0,0,0" Padding="20" Grid.ColumnSpan="2">
            <StackPanel>
                <TextBlock Text="路由配置" FontWeight="Bold" FontSize="15" Margin="0,10,0,0"  Height="40" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="54" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="44" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="更新数据包(Geo)" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0"  Foreground="#616161" FontWeight="Bold" FontSize="12"/>
                            <Image Source="/Resources/cloud.png" HorizontalAlignment="Right" Grid.Column="1" Width="16" Margin="0,0,5,0" MouseLeftButtonUp="Image_MouseLeftButtonUp"  Cursor="Hand"/>
                            <TextBlock Text="{Binding GeoDownProgress}" HorizontalAlignment="Right" Grid.Column="1" Margin="25,2"  Foreground="#616161" FontWeight="Bold" FontSize="12"/>
                            <!-- 虚线 -->
                            <Line Grid.ColumnSpan="2" X1="0" Y1="18" X2="1" Y2="18"
                                  Stretch="Fill"
                                  Stroke="Gray"
                                  StrokeDashArray="2,2"
                                  StrokeThickness="1"
                                  VerticalAlignment="Center"
                                  Margin="300,0,160,0"/>
                        </Grid>
                        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="上次更新时间2025-08-08" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0,0,0"  Foreground="#B2B2B2" FontWeight="Bold" FontSize="10" Grid.ColumnSpan="2"/>
                            <TextBlock Text="" HorizontalAlignment="Left" Grid.Column="3" Margin="404,0,0,0"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="44" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="路由策略" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0"  Foreground="#616161" FontWeight="Bold" FontSize="12"/>
                            <ComboBox Grid.Column="1"
                                      HorizontalAlignment="Right"
                                      Width="80" Margin="0,0,0,0" SelectedIndex="0" ItemsSource="{Binding RoutingStrategyOptions}" SelectedItem="{Binding RoutingStrategy, Mode=TwoWay}"  DisplayMemberPath="."  Cursor="Hand">
                            </ComboBox>
                            <!-- 虚线 -->
                            <Line Grid.ColumnSpan="2" X1="0" Y1="18" X2="1" Y2="18"
                               Stretch="Fill"
                               Stroke="Gray"
                               StrokeDashArray="2,2"
                               StrokeThickness="1"
                               VerticalAlignment="Center"
                               Margin="300,0,160,0"/>
                        </Grid>
                        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="默认使用AsIs规则，本地资源消耗最小" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0,0,0"  Foreground="#B2B2B2" FontWeight="Bold" FontSize="10" Grid.ColumnSpan="2"/>
                            <TextBlock Text="" HorizontalAlignment="Left" Grid.Column="3" Margin="404,0,0,0"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="44" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="直连国内IP" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0"  Foreground="#616161" FontWeight="Bold" FontSize="12"/>
                            <ToggleButton Grid.Column="1"
                                  Width="40"
                                  Height="20"
                                  HorizontalAlignment="Right"
                                  Margin="0,0,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding PassByIp, Mode=TwoWay}" Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Grid>
                                                        <Rectangle x:Name="SwitchBorder" Height="10" Width="20" Fill="LightGray" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                                        <Ellipse x:Name="Knob"
                                                                 Width="12"
                                                                 Height="12"
                                                                 Margin="0"
                                                                 Fill="#3E98F3"/>           
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Knob" Property="Fill" Value="#3E98F3"/>
                                                            <Setter TargetName="Knob" Property="Margin" Value="20,0,0,0"/>
                                                        </Trigger>
                                                        <!-- 关闭状态 -->
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter TargetName="Knob" Property="Fill" Value="Gray"/>
                                                            <Setter TargetName="Knob" Property="Margin" Value="-20,0,0,0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <!-- 虚线 -->
                            <Line Grid.ColumnSpan="2" X1="0" Y1="18" X2="1" Y2="18"
     Stretch="Fill"
     Stroke="Gray"
     StrokeDashArray="2,2"
     StrokeThickness="1"
     VerticalAlignment="Center"
     Margin="300,0,160,0"/>
                        </Grid>
                        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="229*"/>
                                <ColumnDefinition Width="130*"/>
                                <ColumnDefinition Width="32*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="国内IP不使用VPN，直连更快（推荐打开）" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0,0,0"  Foreground="#B2B2B2" FontWeight="Bold" FontSize="10" Grid.ColumnSpan="2"/>
                            <TextBlock Text="" HorizontalAlignment="Left" Grid.Column="3" Margin="32,0,0,0"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="44" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="直连国内域名" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0"  Foreground="#616161" FontWeight="Bold" FontSize="12"/>
                            <ToggleButton Grid.Column="1"
                               Width="40"
                               Height="20"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,0"
                               VerticalAlignment="Center"
                               IsChecked="{Binding PassByDomain, Mode=TwoWay}"  Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Grid>
                                                        <Rectangle x:Name="SwitchBorder" Height="10" Width="20" Fill="LightGray" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                                        <Ellipse x:Name="Knob"
                                              Width="12"
                                              Height="12"
                                              Margin="0"
                                              Fill="#3E98F3"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Knob" Property="Margin" Value="20,0,0,0"/>
                                                        </Trigger>
                                                        <!-- 关闭状态 -->
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter TargetName="Knob" Property="Fill" Value="Gray"/>
                                                            <Setter TargetName="Knob" Property="Margin" Value="-20,0,0,0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <!-- 虚线 -->
                            <Line Grid.ColumnSpan="2" X1="0" Y1="18" X2="1" Y2="18"
     Stretch="Fill"
     Stroke="Gray"
     StrokeDashArray="2,2"
     StrokeThickness="1"
     VerticalAlignment="Center"
     Margin="300,0,160,0"/>
                        </Grid>
                        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="229*"/>
                                <ColumnDefinition Width="130*"/>
                                <ColumnDefinition Width="32*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="国内域名不使用VPN，直连更快（推荐打开）" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0,0,0"  Foreground="#B2B2B2" FontWeight="Bold" FontSize="10" Grid.ColumnSpan="2"/>
                            <TextBlock Text="" HorizontalAlignment="Left" Grid.Column="3" Margin="32,0,0,0"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="44" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="直连局域网ip" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0"  Foreground="#616161" FontWeight="Bold" FontSize="12"/>
                            <ToggleButton Grid.Column="1"
                Width="40"
                Height="20"
                HorizontalAlignment="Right"
                Margin="0,0,0,0"
                VerticalAlignment="Center"
                IsChecked="{Binding PassByVlanIp, Mode=TwoWay}"  Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Grid>
                                                        <Rectangle x:Name="SwitchBorder" Height="10" Width="20" Fill="LightGray" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                                        <Ellipse x:Name="Knob"
                               Width="12"
                               Height="12"
                               Margin="0"
                               Fill="#3E98F3"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Knob" Property="Margin" Value="20,0,0,0"/>
                                                        </Trigger>
                                                        <!-- 关闭状态 -->
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter TargetName="Knob" Property="Fill" Value="Gray"/>
                                                            <Setter TargetName="Knob" Property="Margin" Value="-20,0,0,0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <!-- 虚线 -->
                            <Line Grid.ColumnSpan="2" X1="0" Y1="18" X2="1" Y2="18"
     Stretch="Fill"
     Stroke="Gray"
     StrokeDashArray="2,2"
     StrokeThickness="1"
     VerticalAlignment="Center"
     Margin="300,0,160,0"/>
                        </Grid>
                        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="229*"/>
                                <ColumnDefinition Width="130*"/>
                                <ColumnDefinition Width="32*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="局域网IP不使用VPN，直连更快（推荐打开）" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0,0,0"  Foreground="#B2B2B2" FontWeight="Bold" FontSize="10" Grid.ColumnSpan="2"/>
                            <TextBlock Text="" HorizontalAlignment="Left" Grid.Column="3" Margin="32,0,0,0"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="44" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="直连局域网域名" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0"  Foreground="#616161" FontWeight="Bold" FontSize="12"/>
                            <ToggleButton Grid.Column="1"
                Width="40"
                Height="20"
                HorizontalAlignment="Right"
                Margin="0,0,0,0"
                VerticalAlignment="Center"
                IsChecked="{Binding PassByVlanDomain, Mode=TwoWay}"  Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Grid>
                                                        <Rectangle x:Name="SwitchBorder" Height="10" Width="20" Fill="LightGray" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                                        <Ellipse x:Name="Knob"
                               Width="12"
                               Height="12"
                               Margin="0"
                               Fill="#3E98F3"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Knob" Property="Margin" Value="20,0,0,0"/>
                                                        </Trigger>
                                                        <!-- 关闭状态 -->
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter TargetName="Knob" Property="Fill" Value="Gray"/>
                                                            <Setter TargetName="Knob" Property="Margin" Value="-20,0,0,0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <!-- 虚线 -->
                            <Line Grid.ColumnSpan="2" X1="0" Y1="18" X2="1" Y2="18"
     Stretch="Fill"
     Stroke="Gray"
     StrokeDashArray="2,2"
     StrokeThickness="1"
     VerticalAlignment="Center"
     Margin="300,0,160,0"/>
                        </Grid>
                        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="229*"/>
                                <ColumnDefinition Width="130*"/>
                                <ColumnDefinition Width="32*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="局域网域名不使用VPN，直连更快（推荐打开）" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0,0,0"  Foreground="#B2B2B2" FontWeight="Bold" FontSize="10" Grid.ColumnSpan="2"/>
                            <TextBlock Text="" HorizontalAlignment="Left" Grid.Column="3" Margin="32,0,0,0"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="44" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="阻断广告" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0"  Foreground="#616161" FontWeight="Bold" FontSize="12"/>
                            <ToggleButton Grid.Column="1"
                Width="40"
                Height="20"
                HorizontalAlignment="Right"
                Margin="0,0,0,0"
                VerticalAlignment="Center"
                IsChecked="{Binding BlockAds, Mode=TwoWay}"  Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Grid>
                                                        <Rectangle x:Name="SwitchBorder" Height="10" Width="20" Fill="LightGray" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                                        <Ellipse x:Name="Knob"
                               Width="12"
                               Height="12"
                               Margin="0"
                               Fill="#3E98F3"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Knob" Property="Margin" Value="20,0,0,0"/>
                                                        </Trigger>
                                                        <!-- 关闭状态 -->
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter TargetName="Knob" Property="Fill" Value="Gray"/>
                                                            <Setter TargetName="Knob" Property="Margin" Value="-20,0,0,0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <!-- 虚线 -->
                            <Line Grid.ColumnSpan="2" X1="0" Y1="18" X2="1" Y2="18"
     Stretch="Fill"
     Stroke="Gray"
     StrokeDashArray="2,2"
     StrokeThickness="1"
     VerticalAlignment="Center"
     Margin="300,0,160,0"/>
                        </Grid>
                        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="229*"/>
                                <ColumnDefinition Width="130*"/>
                                <ColumnDefinition Width="32*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="阻断常规广告，个别网站网站无法彻底阻断" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0,0,0"  Foreground="#B2B2B2" FontWeight="Bold" FontSize="10" Grid.ColumnSpan="2"/>
                            <TextBlock Text="" HorizontalAlignment="Left" Grid.Column="3" Margin="32,0,0,0"/>
                        </Grid>
                    </Grid>

                    <!-- <Border Grid.Row="4" Grid.ColumnSpan="3" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1"  HorizontalAlignment="Center" VerticalAlignment="Center"/> -->
                </Grid>
            </StackPanel>
        </materialDesignCards:Card>
        <materialDesignCards:Card Margin="0,450,0,0" Padding="20" Grid.ColumnSpan="2">
            <StackPanel>
                <TextBlock Text="DNS配置" FontWeight="Bold" FontSize="15" Margin="0,10,0,0"  Height="40" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76" />
                        <RowDefinition Height="57" />
                        <RowDefinition Height="57" />
                        <RowDefinition Height="97" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="74" Margin="0,10,0,0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22" />
                            <RowDefinition Height="50" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock HorizontalAlignment="Left" Grid.Column="0" Margin="15,0"  Foreground="#616161" FontWeight="Bold" FontSize="12">
                                启用VPN路由   端口:
                                <Underline>
                                    <Run Text="{Binding VpnDnsPort, Mode=TwoWay, Converter={StaticResource IntStringConverter}, UpdateSourceTrigger=PropertyChanged}"/>
                                </Underline>
                            </TextBlock>
                            <ToggleButton Grid.Column="1"
      Width="40"
      Height="20"
      HorizontalAlignment="Right"
      Margin="0,0,0,0"
      VerticalAlignment="Center"
      IsChecked="{Binding VpnDns, Mode=TwoWay}"  Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Grid>
                                                        <Rectangle x:Name="SwitchBorder" Height="10" Width="20" Fill="LightGray" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                                        <Ellipse x:Name="Knob"
                                     Width="12"
                                     Height="12"
                                     Margin="0"
                                     Fill="#3E98F3"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Knob" Property="Fill" Value="#3E98F3"/>
                                                            <Setter TargetName="Knob" Property="Margin" Value="20,0,0,0"/>
                                                        </Trigger>
                                                        <!-- 关闭状态 -->
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter TargetName="Knob" Property="Fill" Value="Gray"/>
                                                            <Setter TargetName="Knob" Property="Margin" Value="-20,0,0,0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <!-- 虚线 -->
                            <Line Grid.ColumnSpan="2" X1="0" Y1="18" X2="1" Y2="18"
     Stretch="Fill"
     Stroke="Gray"
     StrokeDashArray="2,2"
     StrokeThickness="1"
     VerticalAlignment="Center"
     Margin="300,0,160,0"/>
                        </Grid>
                        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="208"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="如果需要直连国内和局域网地址，推荐启用。外网/内网独 立DNS，更安全隐秘。" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0,0,0"  Foreground="#B2B2B2" FontWeight="Bold" FontSize="10" Grid.ColumnSpan="2" VerticalAlignment="Top"
TextWrapping="WrapWithOverflow" Width="208"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="47" Margin="0,10,0,0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock HorizontalAlignment="Left" Grid.Column="0" Margin="15,0"  Foreground="#616161" FontWeight="Bold" FontSize="12">
                                境外流量DNS
                            </TextBlock>
                            <TextBlock 
                                 HorizontalAlignment="Left"
                                 Grid.Column="1" Margin="-16,0" Foreground="#616161" FontWeight="Bold" FontSize="12"  Visibility="{Binding IsEditingForeignDns, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" Cursor="Hand">
                                <Underline><Run Text="{Binding ForeignDns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Run></Underline>
                                <TextBlock.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                      Command="{Binding EnterEditModeForeignDnsCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                            <TextBox
                                 HorizontalAlignment="Left"
                                 Grid.Column="1" Margin="-16,0" Text="{Binding ForeignDns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#616161" FontWeight="Bold" FontSize="12"
    
                                    KeyDown="ForeignDnsTextBox_KeyDown"
                                    LostFocus="ForeignDnsTextBox_LostFocus"  Visibility="{Binding IsEditingForeignDns, Converter={StaticResource BoolToVisibilityConverter}}">
                            </TextBox>
                        </Grid>
                        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="访问境外使用的DNS，推荐国外DNS" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0,0,0"  Foreground="#B2B2B2" FontWeight="Bold" FontSize="10" Grid.ColumnSpan="2"/>
                            <TextBlock Text="" HorizontalAlignment="Left" Grid.Column="3" Margin="404,0,0,0"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="47" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock HorizontalAlignment="Left" Grid.Column="0" Margin="15,0"  Foreground="#616161" FontWeight="Bold" FontSize="12">
             境内流量DNS
                            </TextBlock>
                            <TextBlock 
              HorizontalAlignment="Left"
              Grid.Column="1" Margin="-16,0" Foreground="#616161" FontWeight="Bold" FontSize="12"  Visibility="{Binding IsEditingInnerCountryDns, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"  Cursor="Hand">
             <Underline><Run Text="{Binding InnerCountryDns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Run></Underline>
                                <TextBlock.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
   Command="{Binding EnterEditModeInnerCountryDnsCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                            <TextBox
              HorizontalAlignment="Left"
              Grid.Column="1" Margin="-16,0" Text="{Binding InnerCountryDns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#616161" FontWeight="Bold" FontSize="12"
    
                 KeyDown="InnerCountryDnsTextBox_KeyDown"
                 LostFocus="InnerCountryDnsTextBox_LostFocus"  Visibility="{Binding IsEditingInnerCountryDns, Converter={StaticResource BoolToVisibilityConverter}}">
                            </TextBox>
                        </Grid>
                        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="访问境内使用的DNS，推荐国内DNS" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0,0,0"  Foreground="#B2B2B2" FontWeight="Bold" FontSize="10" Grid.ColumnSpan="2"/>
                            <TextBlock Text="" HorizontalAlignment="Left" Grid.Column="3" Margin="404,0,0,0"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="87" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="50" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock HorizontalAlignment="Left" Grid.Column="0" Margin="15,0"  Foreground="#616161" FontWeight="Bold" FontSize="12">
          全局流量DNS
                            </TextBlock>
                            <TextBlock 
           HorizontalAlignment="Left"
           Grid.Column="1" Margin="-16,0" Foreground="#616161" FontWeight="Bold" FontSize="12"  Visibility="{Binding IsEditingGlobalDns, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"  Cursor="Hand">
          <Underline><Run Text="{Binding GlobalDns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Run></Underline>
                                <TextBlock.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
Command="{Binding EnterEditModeGlobalDnsCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                            <TextBox
           HorizontalAlignment="Left"
           Grid.Column="1" Margin="-16,0" Text="{Binding GlobalDns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#616161" FontWeight="Bold" FontSize="12"
 
              KeyDown="GlobalDnsTextBox_KeyDown"
              LostFocus="GlobalDnsTextBox_LostFocus"  Visibility="{Binding IsEditingGlobalDns, Converter={StaticResource BoolToVisibilityConverter}}">
                            </TextBox>
                        </Grid>
                        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="233"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="不区分流量，全局一个DNS地址。推荐使用外网DNS地址，如Google的8.8.8.8" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0,0,0"  Foreground="#B2B2B2" FontWeight="Bold" FontSize="10" Grid.ColumnSpan="2" VerticalAlignment="Top"
TextWrapping="WrapWithOverflow" Width="208"/>
                        </Grid>
                    </Grid>
                    

                </Grid>
            </StackPanel>
        </materialDesignCards:Card>
        <materialDesignCards:Card Margin="0,780,0,0" Padding="20" Grid.ColumnSpan="2" >
            <StackPanel Height="100">
                <TextBlock Text="语言" FontWeight="Bold" FontSize="15" Margin="0,10,0,0"  Height="40" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                <Line Grid.ColumnSpan="2" X1="0" Y1="-80" X2="1" Y2="-80"
Stretch="Fill"
Stroke="Gray"
StrokeDashArray="2,2"
StrokeThickness="1"
VerticalAlignment="Center"
Margin="300,0,160,0"/>
                <ComboBox Width="100" Height="32" SelectedIndex="0" FontSize="12" HorizontalAlignment="Right"  Margin="0,-40,0,0" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language, Mode=TwoWay}" DisplayMemberPath=".">
                    <ComboBox.Resources>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </ComboBox.Resources>

                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <!-- 圆角背景 -->
                                            <Border x:Name="BackgroundBorder"
                                    CornerRadius="8"
                                    Background="#F0F0F0"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    Padding="10,4"
                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="0,0,24,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"/>
                                                    <Path x:Name="Arrow"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="#666"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          Width="8" Height="4"/>
                                                </Grid>
                                            </Border>

                                            <!-- ✅ 下拉按钮 -->
                                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="2"
                                          Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"  Cursor="Hand">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>

                                            <!-- ✅ 下拉菜单 -->
                                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide"  Cursor="Hand">
                                                <Border CornerRadius="6"
                                        Background="White"
                                        BorderBrush="#DDD"
                                        BorderThickness="1"
                                        Padding="4"
                                        SnapsToDevicePixels="True"
                                        Margin="0,2,0,0">
                                                    <ScrollViewer MaxHeight="200">
                                                        <StackPanel IsItemsHost="True"/>
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#E8E8E8"/>
                                            </Trigger>
                                            <Trigger Property="IsDropDownOpen" Value="True">
                                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#E0E0E0"/>
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.Style>


                </ComboBox >
            </StackPanel>
        </materialDesignCards:Card>
    </Grid>
</reactiveui:ReactiveUserControl>
