<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.ShareGift"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:materialDesignCards="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:TypeArguments="vms:ProfilesViewModel"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <materialDesignCards:Card Margin="0,0,0,0" Padding="20" Grid.ColumnSpan="2">
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="125" />
                        <RowDefinition Height="105" />
                        <RowDefinition Height="445" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="125" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="25" />
                            <RowDefinition Height="60" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="500"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" Margin="15,0,0,0"  Foreground="#020202" FontWeight="Bold" FontSize="15" Grid.ColumnSpan="2">
                                    <Run Text="分享有礼"/>
                            </TextBlock>
                        </Grid>
                        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>

                            <emoji:TextBlock HorizontalAlignment="Left" Grid.Column="0" Margin="15,0"  Foreground="#020202" FontWeight="Bold" FontSize="14">
                                <Run Text="📝 分享有礼，"/>
                                <Run Text="1000" x:Name="TotalCnt"/>
                                <Run Text="人名额"/>
                            </emoji:TextBlock>
                        </Grid>
                        <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="900"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="晒软件心得 / 教程等至论坛、视频平台、社交媒体、博客等，提交页面链接（非私链，客服可直接打开。私链无奖励！）参与评审。" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0,0,0"  Foreground="#7F7F7F" FontWeight="Bold" FontSize="13" Grid.ColumnSpan="2" VerticalAlignment="Top"
TextWrapping="WrapWithOverflow" Width="900"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="95" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="31*"/>
                            <ColumnDefinition Width="569*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="70" />
                        </Grid.RowDefinitions>
                        <Grid VerticalAlignment="Center" Height="20" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <emoji:TextBlock Text="🏆 奖项设置" HorizontalAlignment="Left" Grid.Column="0" Margin="15,0"  Foreground="#020202" FontWeight="Bold" FontSize="14"/>
                        </Grid>
                        <Grid Grid.Row="1" VerticalAlignment="Center" Height="70" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38.39"/>
                                <ColumnDefinition Width="261.61"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock HorizontalAlignment="Left" Grid.Column="0" Margin="15,0,0,0"  Foreground="#7F7F7F" FontWeight="Bold" FontSize="13" Grid.ColumnSpan="2" LineHeight="18"
           LineStackingStrategy="BlockLineHeight">
                                    <Run Text="一等奖(10 名): 1年VIP"/>
                                    <LineBreak/>
                                    <Run Text="二等奖(20 名): 半年VIP"/>
                                    <LineBreak/>
                                    <Run Text="三等奖(100 名): 季度VIP"/>
                                    <LineBreak/>
                                    <Run Text="参与奖: 1个月 VIP"/>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="445" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="300" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="80" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="500"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" Margin="15,0,0,0"  Foreground="#7F7F7F" FontWeight="Bold" FontSize="12" Grid.ColumnSpan="2">
                                <Run Text="剩余名额："/><Run Text="520" Foreground="#286AFC" x:Name="RestCnt"/>
                            </TextBlock>
                        </Grid>
                        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F3F6FB">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="500"/>
                            </Grid.ColumnDefinitions>
                            
                            <ListView x:Name="UserList"
                                  BorderThickness="0"
                                  FontSize="13"
                                  Margin="0,0,0,0"
                                  AlternationCount="0"
                                  Height="240" >
                                <ListView.View >
                                    <GridView>
                                        <GridViewColumn Header="用户名" DisplayMemberBinding="{Binding UserName}" Width="150"/>
                                        <GridViewColumn Header="有效期" DisplayMemberBinding="{Binding ExpireDate}" Width="150" />
                                        <GridViewColumn Header="奖励" DisplayMemberBinding="{Binding Reward}" Width="150" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                        <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Height="45">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="500"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="10"
                    Background="#F7F7F8"
                    Margin="0,0,0,0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2">
                            <TextBox x:Name="AuditLink"
                              Grid.Column="0"
                              Margin="0,0,0,0"
                              Foreground="#1B1B1B"
                              Background="Transparent"
                              BorderThickness="0"   
                              Padding="12"
                              FontSize="13"
                              TextWrapping="Wrap"
                              AcceptsReturn="True"                     
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              SpellCheck.IsEnabled="True"
                              Height="45" Grid.ColumnSpan="2"  Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>
                            <TextBlock x:Name="Placeholder"
                               Text="提交链接"
                               Foreground="#AAAAAA"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontSize="14"  Visibility="{Binding InputText, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                        </Grid>
                        <Grid Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Height="80">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1"
            Margin="0,0,0,0"
            Background="#F7F7F8"
            BorderThickness="0"
            FontSize="12"
            FontWeight="Bold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                                <!-- 内容区域 -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,6,0">
                                    <!-- 图标 -->
                                    <TextBlock Text="发送" VerticalAlignment="Center" Foreground="#286AFC" MouseLeftButtonDown="Send_MouseLeftButtonDown"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                    <!-- <Border Grid.Row="4" Grid.ColumnSpan="3" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1"  HorizontalAlignment="Center" VerticalAlignment="Center"/> -->
                </Grid>
            </StackPanel>
        </materialDesignCards:Card>
    </Grid>
    
</reactiveui:ReactiveUserControl>
