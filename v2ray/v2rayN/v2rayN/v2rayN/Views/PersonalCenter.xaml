<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.PersonalCenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:materialDesignCards="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    xmlns:behaviors="clr-namespace:v2rayN.Behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    x:TypeArguments="vms:ProfilesViewModel"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:DelayColorConverter x:Key="DelayColorConverter" />
    </UserControl.Resources>
    <materialDesign:DialogHost Identifier="DialogHostMain" x:Name="DialogHostMain">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="79*"/>
                <ColumnDefinition Width="681*"/>
            </Grid.ColumnDefinitions>

            <materialDesignCards:Card Margin="0,0,0,0" Padding="20" Grid.ColumnSpan="2">
                <StackPanel>
                    <TextBlock Text="个人资料" FontWeight="Bold" FontSize="14" Margin="0,20,0,10"  Height="30"/>
                    <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60" />
                                <RowDefinition Height="60" />
                                <RowDefinition Height="60" />
                                <RowDefinition Height="60" />
                                <RowDefinition Height="60" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*" MinWidth="300"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="用户ID" VerticalAlignment="Center" Grid.Column="0" Margin="15,0"  Foreground="#1B1B1B" FontWeight="Bold"/>
                                <TextBlock Text="{Binding uuid}"  x:Name="UUID" VerticalAlignment="Center" Grid.Column="1" Margin="5,0"/>

                                <Image Source="/Resources/copy.png" Grid.Column="2" Width="32" Margin="0,10,60,0"  MouseLeftButtonDown="Copy_Image_MouseLeftButtonDown"/>

                                <Rectangle Grid.ColumnSpan="3" Height="1" Fill="#EEEEEE" Margin="15,0,15,0" VerticalAlignment="Bottom"/>
                            </Grid>

                            <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="85*" MinWidth="300"/>
                                    <ColumnDefinition Width="81*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <!-- 标题 -->
                                <TextBlock Text="登录邮箱" VerticalAlignment="Center" Grid.Column="0" Margin="15,0,15,0" Foreground="#1B1B1B" FontWeight="Bold"/>

                                <!-- 显示的邮箱 -->
                                <TextBlock Text="{Binding username}"  x:Name="Email"  VerticalAlignment="Center" Grid.Column="1"  Margin="5,0,5,0" Grid.ColumnSpan="2"/>

                                <!-- 编辑按钮 -->
                                <Button Content="更换邮箱" FontSize="12" FontWeight="Bold" Grid.Column="3" Margin="0,14,15,14" Background="#F7F7F8" BorderThickness="0" Click="EditEmail_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#E9F0FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Rectangle Grid.ColumnSpan="4" Height="1" Fill="#EEEEEE"  Margin="15,0,15,0"  VerticalAlignment="Bottom"/>

                                <!-- 邮箱编辑面板 -->
                                <StackPanel x:Name="EmailEditPanel" Orientation="Horizontal" Grid.Column="1" Grid.ColumnSpan="3" Visibility="Collapsed" VerticalAlignment="Center" Margin="5,0,0,0">
                                    <TextBox x:Name="NewEmailTextBox" Width="150" Height="28" VerticalAlignment="Center" Margin="0,0,5,0"
                                        LostFocus="TextBox_LostFocus" behaviors:PlaceholderBehavior.Placeholder="新邮箱" />
                                    <TextBox x:Name="VerificationCodeTextBox" Width="100" Height="28" VerticalAlignment="Center" Margin="0,0,5,0"
                                       LostFocus="TextBox_LostFocus" behaviors:PlaceholderBehavior.Placeholder="验证码" />
                                    <Button x:Name="SendCode" Content="验证码" Width="108" Height="28" Margin="0,0,5,0" Click="SendCode_Click"/>
                                </StackPanel>
                            </Grid>


                            <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*" MinWidth="300"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <!-- 标签 -->
                                <TextBlock Text="用户昵称" VerticalAlignment="Center" Grid.Column="0" Margin="15,0" Foreground="#1B1B1B" FontWeight="Bold"/>

                                <!-- 显示昵称 -->
                                <TextBlock x:Name="UserName" Text="{Binding nick}" VerticalAlignment="Center" Grid.Column="1" Margin="5,0"/>

                                <!-- 编辑昵称面板（默认隐藏） -->
                                <StackPanel x:Name="UserNameEditPanel" Orientation="Horizontal" Grid.Column="1" Margin="5,0" Visibility="Collapsed">
                                    <TextBox x:Name="UserNameTextBox" Width="150" VerticalAlignment="Center" LostFocus="UserNameTextBox_LostFocus"/>
                                </StackPanel>

                                <!-- 编辑按钮 -->
                                <Button Content="编辑昵称" FontSize="12" FontWeight="Bold" Grid.Column="2" Margin="0,0,15,0" Background="#F7F7F8" BorderThickness="0" Click="EditUserName_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#E9F0FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- 分割线 -->
                                <Rectangle Grid.ColumnSpan="3" Height="1" Fill="#EEEEEE" Margin="15,0,15,0" VerticalAlignment="Bottom"/>
                            </Grid>


                            <Grid Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*" MinWidth="300"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="国家" VerticalAlignment="Center" Grid.Column="0" Margin="15,0"  Foreground="#1B1B1B" FontWeight="Bold"/>
                                <TextBlock x:Name="Country" VerticalAlignment="Center" Grid.Column="1" Margin="5,0"/>
                                
                                <Button Content="修改" FontSize="12" FontWeight="Bold" Grid.Column="2"  Margin="0,0,15,0" Background="#F7F7F8" BorderThickness="0" Click="EditRegion_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                                <!-- 设置圆角 -->
                                                <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#E9F0FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Rectangle Grid.ColumnSpan="3" Height="1" Fill="#EEEEEE"  Margin="15,0,15,0"  VerticalAlignment="Bottom"/>

                                <!-- 邮箱编辑面板 -->
                                <StackPanel x:Name="RegionEditPanel" Orientation="Horizontal" Grid.Column="1" Grid.ColumnSpan="3" Visibility="Collapsed" VerticalAlignment="Center" Margin="5,0,0,0">
                                    <ComboBox x:Name="CountryComboBox"
                                      Grid.Column="1"
                                      Margin="0,0"
                                      Padding="6,3"
                                      VerticalAlignment="Center"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Code"
                                      SelectedValue="{Binding country, Mode=TwoWay}"
                                      BorderBrush="#D0D0D0"
                                      BorderThickness="1"
                                      Background="White"
                                      Foreground="Black" SelectionChanged="Region_ComboBox_Chanaged" DropDownClosed="RegionComboBox_DropDownClosed"/>
                              
                                </StackPanel>
                            </Grid>


                            <Grid Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="60" Cursor="">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*" MinWidth="300"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="密码" VerticalAlignment="Center" Grid.Column="0" Margin="15,0"  Foreground="#1B1B1B" FontWeight="Bold"/>
                                <PasswordBox VerticalAlignment="Center"
                                 Grid.Column="1"
                                 x:Name="Password"
                                 Width="200"
                                 MaxLength="12"
                                 FocusVisualStyle="{x:Null}"
                                 BorderBrush="Transparent" 
                                 Background="Transparent">
                                    <PasswordBox.Style>
                                        <Style TargetType="PasswordBox">
                                            <!-- Set password characteristics -->
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="PasswordChar" Value="●"/>
                                            <Setter Property="MaxLength" Value="12"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="FontSize" Value="16"/>
                                            <Setter Property="Width" Value="200"/>
                                            <Setter Property="Height" Value="30"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>

                                            <Style.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </PasswordBox.Style>
                                </PasswordBox>
                                <Button Content="修改密码" FontSize="12" FontWeight="Bold" Grid.Column="2" Margin="0,0,15,0" Background="#F7F7F8" BorderThickness="0" Click="ChangePasswordButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                                <!-- 设置圆角 -->
                                                <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#E9F0FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                            </Grid>


                            <!-- <Border Grid.Row="4" Grid.ColumnSpan="3" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1"  HorizontalAlignment="Center" VerticalAlignment="Center"/> -->
                        </Grid>
                    </Border>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" Margin="150,35,0,0" Width="320" Height="85">
                            <Border CornerRadius="4"
                                Background="#EAEAEC"
                                Height="85"
                                ClipToBounds="True"
                                VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0">
                                        <TextBlock Foreground="White" Width="136">
                                                <Run Text="高匿名" FontSize="18" Foreground="#2A2A2A"/>
                                                <Run Text=" " FontSize="10" />
                                        </TextBlock>
                                        <TextBlock Text="HTTPS/CHACHA20加密访问" FontSize="10"  Foreground="#A7A7A8" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="90,0,0,0">
                                        <Image Source="/Resources/privacy_icon.png" Width="50"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" Margin="0,35,150,0" Width="320" Height="85">
                            <Border CornerRadius="4"
                            Background="#EAEAEC"
                            Height="85"
                            ClipToBounds="True"
                            VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" >
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0">
                                        <TextBlock Foreground="White" Width="136">
                                            <Run Text="隧道自由" FontSize="18" Foreground="#2A2A2A"/>
                                             <Run Text=" " FontSize="10" />
                                        </TextBlock>
                                        <TextBlock Text="灵活调节线路2" FontSize="10"  Foreground="#A7A7A8" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="90,0,0,0">
                                        <Image Source="/Resources/tunel_icon.png" Width="50"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" Margin="150,15,0,0" Width="320"  Height="85">
                            <Border CornerRadius="4"
                                Background="#EAEAEC"
                                Height="85"
                                ClipToBounds="True"
                                VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0">
                                        <TextBlock Foreground="White" Width="136">
                                                <Run Text="弹性并发" FontSize="18" Foreground="#2A2A2A"/>
                                                <Run Text=" " FontSize="10" />
                                        </TextBlock>
                                        <TextBlock Text="超大带宽，弹性并发" FontSize="10"  Foreground="#A7A7A8" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="90,0,0,0">
                                        <Image Source="/Resources/concurrency_icon.png" Width="50"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" Margin="0,15,150,0" Width="320" Height="85">
                            <Border CornerRadius="4"
                                Background="#EAEAEC"
                                Height="85"
                                ClipToBounds="True"
                                VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0">
                                        <TextBlock Foreground="White" Width="136">
                                                <Run Text="安全稳定" FontSize="18"  Foreground="#2A2A2A" />
                                                 <Run Text=" " FontSize="10" />
                                        </TextBlock>
                                        <TextBlock Text="数据传输稳定可靠" FontSize="10"  Foreground="#A7A7A8" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="90,0,0,0">
                                        <Image Source="/Resources/guard_icon.png" Width="50"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesignCards:Card>
        </Grid>
    </materialDesign:DialogHost>
</reactiveui:ReactiveUserControl>
