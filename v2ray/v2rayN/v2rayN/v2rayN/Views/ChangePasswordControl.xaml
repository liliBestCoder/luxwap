<UserControl x:Class="v2rayN.Views.ChangePasswordControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:v2rayN.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             Width="300" Height="330">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="修改密码" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Margin="0,10">
            <PasswordBox x:Name="OldPasswordBox" behaviors:PlaceholderBehavior.Placeholder="旧密码"  behaviors:PasswordBoxAssistant.BoundPassword="{Binding OldPassword, Mode=TwoWay}"/>
        </Grid>
        
        <!-- 新密码 -->
        <Grid Margin="0,20">
            <PasswordBox x:Name="NewPasswordBox" behaviors:PlaceholderBehavior.Placeholder="新密码"  behaviors:PasswordBoxAssistant.BoundPassword="{Binding NewPassword, Mode=TwoWay}"/>
        </Grid>

        <!-- 确认新密码 -->
        <Grid Margin="0,30">
            <PasswordBox x:Name="ConfirmPasswordBox" behaviors:PlaceholderBehavior.Placeholder="确认新密码"  behaviors:PasswordBoxAssistant.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Width="60" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="确认" Width="60" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
