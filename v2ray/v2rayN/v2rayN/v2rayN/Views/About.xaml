<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.About"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:materialDesignCards="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:TypeArguments="vms:ProfilesViewModel"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <Grid>
            <materialDesignCards:Card Margin="0" Padding="20">
                <StackPanel>

                    <!-- 标题区 -->
                    <TextBlock Text="关于 Luxwap"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#1B1B1B"
                               Margin="0,0,0,0"/>

                    <!-- 版本信息 -->
                    <DockPanel LastChildFill="False" Margin="0,5,0,10" Height="30">
                        <TextBlock Text="稳定版本：V2.1.3.20250818_release"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Foreground="#1B1B1B"/>
                        <Button DockPanel.Dock="Left"
                                Margin="20,0,0,0"
                                Background="#F7F7F8"
                                BorderThickness="0"
                                FontSize="12"
                                Padding="10,4"
                                FontWeight="Bold"
                                HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Resources/update.png"
                                       Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="更新软件"
                                           Foreground="#1B1B1B"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <!-- 版本说明 -->
                    <TextBlock Text="版本说明"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#1B1B1B"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="本软件持续迭代优化，如需获取最新版本或反馈问题，请联系支持团队。"
                               TextWrapping="Wrap"
                               Foreground="#1B1B1B"  Margin="0,5,0,0"/>

                    <!-- 反馈标题 -->
                    <TextBlock Text="反馈"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#1B1B1B"
                               Margin="0,20,0,5"/>

                    <!-- 反馈输入框 -->
                    <Border Background="#F7F7F8"
                            CornerRadius="10"
                            Padding="0"
                            Height="400" Margin="0,5,300,0">
                        <TextBox x:Name="InputBox"
                                 Foreground="#1B1B1B"
                                 Background="#F7F7F8"
                                 BorderThickness="0"
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 SpellCheck.IsEnabled="True"
                                 MaxLength="2000"
                                 MinHeight="200"/>
                    </Border>

                </StackPanel>
            </materialDesignCards:Card>
        </Grid>
    </ScrollViewer>
</reactiveui:ReactiveUserControl>
