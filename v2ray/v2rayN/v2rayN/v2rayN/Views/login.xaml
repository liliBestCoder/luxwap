<base:WindowBase x:Class="v2rayN.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:materialDesignCards="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/shared"
        xmlns:conv="clr-namespace:v2rayN.Converters"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:base="clr-namespace:v2rayN.Base"
        xmlns:vms="clr-namespace:v2rayN.ViewModels"
        xmlns:behaviors="clr-namespace:v2rayN.Behaviors"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        x:TypeArguments="vms:LoginViewModel"
        mc:Ignorable="d"
        Title="Luxwap" Height="760" Width="420">

    <Window.Resources>
        <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
    </Window.Resources>

    <Grid  Width="382" HorizontalAlignment="Center">
        <!-- 顶部蓝色背景 -->
        <Border Background="#2A80FF" CornerRadius="0,0,30,30"
                Height="200" VerticalAlignment="Top" Grid.ColumnSpan="3" />

        <!-- Logo -->
        <StackPanel VerticalAlignment="Top" Margin="0,30,0,0" HorizontalAlignment="Center" Grid.ColumnSpan="2">
            <Image Source="/Resources/icon_logo.png" Width="64" Height="64" HorizontalAlignment="Center"/>
            <TextBlock Text="Luxwap" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 登录卡片 -->
        <Border Background="White" CornerRadius="20" Width="320" Height="500"
                HorizontalAlignment="Center" Padding="30"
                Margin="0,150,0,0"
                Visibility="{Binding Mode, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}">
            <StackPanel Width="260" HorizontalAlignment="Center">
                <!-- 登录标题 -->
                <TextBlock Text="账号登录" FontSize="18" FontWeight="Bold" Foreground="#1B1B1B" Margin="0,0,0,20"/>
                <!-- 邮箱 -->
                <Border Background="#F4F6FB" CornerRadius="10" Padding="10" Margin="0,0,0,10" Height="60">
                    <DockPanel>
                        <TextBlock Text="📧" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="LoginEmail" Background="Transparent" BorderThickness="0" Padding="12"
                                  Height="50" VerticalAlignment="Center"  FontSize="14" Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}" behaviors:PlaceholderBehavior.Placeholder="请输入邮箱" />
                    </DockPanel>
                </Border>
                <!-- 密码 -->
                <Border Background="#F4F6FB" CornerRadius="10" Padding="10" Margin="0,0,0,10" Height="60">
                    <DockPanel>
                        <TextBlock Text="🔒" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <PasswordBox x:Name="LoginPassword" Background="Transparent" BorderThickness="0" Padding="12"
                                      Height="50" VerticalAlignment="Center"  PasswordChanged="PwdBox_PasswordChanged"  behaviors:PlaceholderBehavior.Placeholder="请输入密码" />
                    </DockPanel>
                </Border>
                <!-- 忘记密码 -->
                <Button Content="忘记密码？"
                    FontSize="12"
                    Foreground="#2A80FF"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,15"
                    Cursor="Hand"
                    Command="{Binding SwitchToResetPwdCommand}" />
                <!-- 登录按钮 -->
                <Button Content="登录" Background="#2A80FF" Foreground="White" FontSize="15" FontWeight="Bold"
                    BorderThickness="0" Height="40" Margin="0,0,0,10" Cursor="Hand"
                    Command="{Binding LoginCommand}" >
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                    CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="免费试用" Background="#E8F0FE" Foreground="#2A80FF" FontSize="15" FontWeight="Bold"
                        BorderThickness="0" Height="40" Cursor="Hand"  Command="{Binding SwitchToRegisterCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
 CornerRadius="8"
             BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Margin="0,25,0,0" HorizontalAlignment="Center" Width="260" VerticalAlignment="Center">
                    <TextBlock Text="--其他账号授权登录--" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Width="260">
                        <Button Command="{Binding XLoginCommand}" Background="Transparent" BorderThickness="0" Width="65" Height="60">
                            <StackPanel Orientation="Vertical">
                                <Image Source="/Resources/icon_X_logo.png" Width="24" Height="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="X账户" Height="32" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"  FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GoogleLoginCommand}" Background="Transparent" BorderThickness="0" Width="100"  Height="60" Margin="11,0">
                            <StackPanel Orientation="Vertical">
                                <Image Source="/Resources/icon_Google_logo.png" Width="24" Height="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="Google" Height="32" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"  FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding FacebookLoginCommand}" Background="Transparent" BorderThickness="0" Width="95"  Height="60" Margin="-20,0">
                            <StackPanel Orientation="Vertical">
                                <Image Source="/Resources/icon_facebook_logo.png" Width="24" Height="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="Facebook" Height="32" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 注册卡片 -->
        <Border Background="White" CornerRadius="20" Width="320" Height="500"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30"
                Margin="0,150,0,0"
                Visibility="{Binding Mode, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=2}">
            <StackPanel>
                <!-- 注册标题 -->
                <TextBlock Text="账号注册" FontSize="18" FontWeight="Bold" Foreground="#1B1B1B" Margin="0,0,0,20"/>
                <!-- 邮箱 -->
                <Border Background="#F4F6FB" CornerRadius="10" Padding="10" Margin="0,0,0,10" Height="60">
                    <DockPanel>
                        <TextBlock Text="📧" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="RegisterEmail" Background="Transparent" BorderThickness="0" Padding="12"
                                 FontSize="14" Height="50" VerticalAlignment="Center" Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}" LostFocus="RegisterEmail_LostFocus"  behaviors:PlaceholderBehavior.Placeholder="请输入邮箱" />
                    </DockPanel>
                </Border>
                <!-- 密码 -->
                <Border Background="#F4F6FB" CornerRadius="10" Padding="10" Margin="0,0,0,10" Height="60">
                    <DockPanel>
                        <TextBlock Text="🔒" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <PasswordBox x:Name="RegisterPassword" Background="Transparent" BorderThickness="0" Padding="12"
                                     Height="50" VerticalAlignment="Center"  PasswordChanged="RegisterPwdBox_PasswordChanged"  behaviors:PlaceholderBehavior.Placeholder="请输入密码" />
                    </DockPanel>
                </Border>
                <!-- 确认密码 -->
                <Border Background="#F4F6FB" CornerRadius="10" Padding="10" Margin="0,0,0,10" Height="60">
                    <DockPanel>
                        <TextBlock Text="🔒" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <PasswordBox x:Name="RegisterConfirmPassword" Background="Transparent" BorderThickness="0" Padding="12"
                                     Height="50" VerticalAlignment="Center"  PasswordChanged="RegisterConfirmPwdBox_PasswordChanged"  behaviors:PlaceholderBehavior.Placeholder="请再次输入密码" />
                    </DockPanel>
                </Border>
                <!-- 验证码 -->
                <Border Background="#F4F6FB" CornerRadius="10" Padding="10" Margin="0,0,0,10" Height="60"
                        Visibility="{Binding IsCodeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <TextBlock Text="🔑" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="RegisterCode" Background="Transparent" BorderThickness="0" Padding="12"
                                  Height="50" VerticalAlignment="Center"  FontSize="14" Text="{Binding RegisterCode, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="{Binding CodeCountdown}" Margin="10,0,0,0"
                                IsEnabled="{Binding CanSendCode}" Command="{Binding SendCodeCommand}" Width="120" Height="40"
                                HorizontalAlignment="Right" VerticalAlignment="Center"/>

                    </DockPanel>
                </Border>
                <!-- 注册按钮 -->
                <Button Content="注册" Background="#2A80FF" Foreground="White" FontSize="15" FontWeight="Bold"
                        BorderThickness="0" Height="40" Cursor="Hand"  Command="{Binding RegsiterCommand}" Margin="0,10,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" 
                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 左下角返回按钮 -->
                <Button DockPanel.Dock="Bottom"
                    Content="← 返回登录"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    Foreground="#2A80FF"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"
                    Command="{Binding BackToLoginCommand}"
                    Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
        <!-- 忘记密码卡片 -->
        <Border Background="White" CornerRadius="20" Width="320" Height="500"
        VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30"
        Margin="0,150,0,0"
        Visibility="{Binding Mode, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=3}">

            <StackPanel>

                <!-- 标题 -->
                <TextBlock Text="重置密码" FontSize="18" FontWeight="Bold" Foreground="#1B1B1B" Margin="0,0,0,20"/>

                <!-- 邮箱 -->
                <Border Background="#F4F6FB" CornerRadius="10" Padding="10" Margin="0,0,0,10" Height="60">
                    <DockPanel>
                        <TextBlock Text="📧" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="ResetEmail" Background="Transparent" BorderThickness="0" Padding="12"
                         Height="50" VerticalAlignment="Center" FontSize="14"
                         Text="{Binding ResetEmail, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:PlaceholderBehavior.Placeholder="请输入注册邮箱" LostFocus="ResettEmail_LostFocus" />
                    </DockPanel>
                </Border>

                <!-- 新密码 -->
                <Border Background="#F4F6FB" CornerRadius="10" Padding="10" Margin="0,0,0,10" Height="60">
                    <DockPanel>
                        <TextBlock Text="🔒" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <PasswordBox x:Name="ResetPassword" Background="Transparent" BorderThickness="0" Padding="12"
                             Height="50" VerticalAlignment="Center"
                             PasswordChanged="ResetPwdBox_PasswordChanged"
                             behaviors:PlaceholderBehavior.Placeholder="请输入新密码"/>
                    </DockPanel>
                </Border>

                <!-- 确认新密码 -->
                <Border Background="#F4F6FB" CornerRadius="10" Padding="10" Margin="0,0,0,10" Height="60">
                    <DockPanel>
                        <TextBlock Text="🔒" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <PasswordBox x:Name="ResetConfirmPassword" Background="Transparent" BorderThickness="0" Padding="12"
                             Height="50" VerticalAlignment="Center"
                             PasswordChanged="ResetConfirmPwdBox_PasswordChanged"
                             behaviors:PlaceholderBehavior.Placeholder="请再次输入新密码"/>
                    </DockPanel>
                </Border>

                <!-- 验证码 -->
                <Border Background="#F4F6FB" CornerRadius="10" Padding="10" Margin="0,0,0,10" Height="60" Visibility="{Binding IsResetCodeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <TextBlock Text="🔑" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="ResetCode" Background="Transparent" BorderThickness="0" Padding="12"
                         Height="50" VerticalAlignment="Center" FontSize="14"
                         Text="{Binding ResetCode, UpdateSourceTrigger=PropertyChanged}"
                         behaviors:PlaceholderBehavior.Placeholder="请输入验证码"/>
                        <Button Content="{Binding ResetCodeCountdown}" Margin="10,0,0,0"
                        IsEnabled="{Binding ResetCanSendCode}" Command="{Binding ResetSendCodeCommand}"
                        Width="120" Height="40"
                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- 提交按钮 -->
                <Button Content="重置密码" Background="#2A80FF" Foreground="White" FontSize="15" FontWeight="Bold"
                BorderThickness="0" Height="40" Cursor="Hand"
                Command="{Binding ResetPasswordCommand}" Margin="0,10,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" 
                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 左下角返回按钮 -->
                <Button Content="← 返回登录"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Foreground="#2A80FF"
                BorderThickness="0"
                FontSize="13"
                Cursor="Hand"
                Command="{Binding BackToLoginCommand}"
                Margin="0,20,0,0"/>

            </StackPanel>
        </Border>


        <!-- 授权登录 Loading 遮罩 -->
        <Grid Visibility="{Binding IsOauthLoading, Converter={StaticResource BoolToVisibilityConverter}}" Background="#80000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="150" Height="20"/>
                <TextBlock Text="登录中..." Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
    </base:WindowBase>
