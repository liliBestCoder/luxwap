<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 蓝色圆角背景 -->
    <View
        android:id="@+id/back_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_blue_round"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guideline"/>

    <!-- 40 % 分割线 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.45"/>

    <!-- 语言按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_language"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="80dp"
        android:layout_height="42dp"
        android:text="语言"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="0dp"
        app:icon="@drawable/ic_language"
        app:iconTint="#FFFFFF"
        app:iconGravity="start"
        app:cornerRadius="12dp"
        app:backgroundTint="#33FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="@id/white_card"
        android:layout_marginTop="34dp"/>

    <!-- HELLO -->
    <TextView
        android:id="@+id/tv_hello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HELLO"
        android:textSize="40sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/back_layout"
        app:layout_constraintStart_toStartOf="@id/white_card"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="120dp"/>

    <!-- 欢迎来到 -->
    <TextView
        android:id="@+id/tv_welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="欢迎来到"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_hello"
        app:layout_constraintStart_toStartOf="@id/tv_hello" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/icon_logo"
        android:scaleType="fitCenter"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/tv_hello"
        app:layout_constraintBottom_toBottomOf="@id/tv_welcome"
        app:layout_constraintEnd_toEndOf="@+id/white_card"
        android:layout_marginEnd="30dp"/>

    <!-- 白色悬浮卡片 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/white_card"
        android:layout_width="324dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome"
        android:layout_marginTop="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 真正的 Tab + ViewPager2 -->
        <LinearLayout
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 1. 整栏背景（用 FrameLayout 叠图+文字） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">

                <!-- 底图 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tab_bg_selector"
                    android:id="@+id/tabBarBg"
                    android:scaleType="fitXY"/>

                <!-- 文字容器，横向平分 -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="50dp">

                    <!-- 登录 -->
                    <TextView
                        android:id="@+id/btnLogin"
                        android:layout_width="234dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:text="账号登录"
                        android:textColor="#000000"
                        android:layout_marginTop="-15dp"
                        android:textSize="16sp" />

                    <!-- 注册 -->
                    <TextView
                        android:id="@+id/btnReg"
                        android:layout_width="213dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:text="账号注册"
                        android:textColor="#000000"
                        android:layout_marginTop="-15dp"
                        android:textSize="16sp" />
                </LinearLayout>
                <View
                    android:id="@+id/indicator"
                    android:layout_width="60dp"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_blue_flat" />
            </FrameLayout>

            <!-- 2. 全局 1 dp 灰线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"/>

            <!-- 3. 内容区 -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>